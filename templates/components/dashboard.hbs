{{!-- dashboard.hbs - 首页 Dashboard 组件（欢迎语 + 嵌入时钟） --}}
<div class="dashboard-grid">
    {{!-- 左侧：欢迎语 --}}
    <div class="dashboard-intro">
        <div class="dashboard-welcome">
            <h1 class="welcome-title">{{title}}</h1>
            <p class="welcome-subtitle">{{subtitle}}</p>
        </div>
    </div>

    {{!-- 右侧：嵌入外部时钟 --}}
    <div class="dashboard-stats">
        <div class="dashboard-clock-embed">
            <iframe 
                src="https://clock.kakacn.com/" 
                frameborder="0" 
                scrolling="no"
                title="Clock">
            </iframe>
        </div>
    </div>
</div>
